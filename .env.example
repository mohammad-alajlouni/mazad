# Copy to .env; replace ALL three secrets before startup.
POSTGRES_DB=automation
POSTGRES_USER=automation
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://automation:replace-with-a-random-database-password@localhost:5432/automation
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_SECURE=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=10
